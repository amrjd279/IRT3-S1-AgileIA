# Copier ce fichier en .env et y mettre vos vraies valeurs
# .env est dans .gitignore et ne doit JAMAIS être committé

# Clé API Gemini (obligatoire)
# Récupérer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...votre_cle_ici

# Configuration de l'app
APP_NAME=Mon Projet IA
ENVIRONMENT=development

# CORS : URLs autorisées (séparées par virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Limites
MAX_TOKENS_DEFAULT=1000
RATE_LIMIT_PER_MINUTE=20

# Base de données (SQLite par défaut)
DATABASE_URL=sqlite:///./app.db
